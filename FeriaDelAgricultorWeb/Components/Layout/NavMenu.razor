@using FeriaDelAgricultorWeb.Services
@inject SessionUsuarioService SessionUsuarioService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Feria del Agricultor</a>
    </div>
</div>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="flex-column">
        @if (SessionUsuarioService.EstaAutenticado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Hogar
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/feria">
                    Feria (comprar)
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/carrito">
                    Carrito
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/login">
                    Acceso
                </NavLink>
            </div>
        }
    </nav>
</div>
