@page "/carrito"
@using FeriaDelAgricultorModels
@using FeriaDelAgricultorController
@inject CarritoService CarritoService
@inject FacturaService FacturaService

<h3>Carrito de compras</h3>

@if (!string.IsNullOrWhiteSpace(MensajeExito))
{
    <div class="alert alert-success">@MensajeExito</div>
}
@if (!string.IsNullOrWhiteSpace(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Productos.Count == 0)
{
    <div class="alert alert-info">El carrito está vacío.</div>
    <a class="btn btn-secondary" href="/feria">Volver a feria</a>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Puesto</th>
                <th>Producto</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Subtotal</th>
                <th style="width:120px;">Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Productos)
            {
                <tr>
                    <td>@p.Productor</td>
                    <td>@p.NombreProducto</td>
                    <td>₡@p.Precio</td>
                    <td>@p.Cantidad</td>
                    <td>₡@(p.Precio* p.Cantidad)</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Eliminar(p.Productor, p.NombreProducto)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Total (carrito): ₡@TotalCarrito</h5>

    <div style="margin-top:12px; display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-secondary" href="/feria">Seguir comprando</a>
        <button class="btn btn-warning" @onclick="Vaciar">Vaciar carrito</button>
    </div>

    <hr />

    <h4>Finalizar compra (Factura)</h4>

    <div class="row" style="gap:16px; display:flex; flex-wrap:wrap;">
        <div style="min-width:260px;">
            <label><b>Usuario (username)</b></label><br />
            <input class="form-control" @bind="Username" placeholder="Ej: ntobal" />
        </div>

        <div style="min-width:260px;">
            <label><b>Nombre</b></label><br />
            <input class="form-control" @bind="Nombre" placeholder="Ej: Natalia" />
        </div>

        <div style="min-width:260px;">
            <label><b>Apellido</b></label><br />
            <input class="form-control" @bind="Apellido" placeholder="Ej: Tobal" />
        </div>
    </div>

    <div class="row" style="gap:16px; display:flex; flex-wrap:wrap; margin-top:12px;">
        <div style="min-width:260px;">
            <label><b>Provincia (entrega)</b></label><br />
            <input class="form-control" @bind="ProvinciaEntrega" placeholder="Ej: Cartago" />
        </div>

        <div style="min-width:260px;">
            <label><b>Distrito</b></label><br />
            <input class="form-control" @bind="DistritoEntrega" placeholder="Ej: Oriental" />
        </div>

        <div style="min-width:420px; flex:1;">
            <label><b>Señas / detalles</b></label><br />
            <input class="form-control" @bind="SenasEntrega" placeholder="Ej: 200m sur del parque..." />
        </div>
    </div>

    <div class="row" style="gap:16px; display:flex; flex-wrap:wrap; margin-top:12px;">
        <div style="min-width:260px;">
            <label><b>Método de pago</b></label><br />
            <select class="form-select" @bind="MetodoPagoSeleccionado">
                <option value="@MetodoPago.Efectivo">Efectivo</option>
                <option value="@MetodoPago.Sinpe">Sinpe</option>
                <option value="@MetodoPago.Tarjeta">Tarjeta</option>
            </select>
        </div>
    </div>

    <div style="margin-top:14px;">
        <button class="btn btn-success" @onclick="FinalizarCompra">
            Generar factura y guardar
        </button>
    </div>
}

@if (FacturaGenerada != null)
{
    <hr />
    <h4>Resumen de factura</h4>

    <div class="alert alert-info">
        <b>Fecha:</b> @FacturaGenerada.Fecha.ToString("yyyy-MM-dd") <br />
        <b>Usuario:</b> @FacturaGenerada.Cliente.Username <br />
        <b>Método de pago:</b> @FacturaGenerada.MetodoPago <br />
        <b>Entrega:</b> @FacturaGenerada.Direccion.Province - @FacturaGenerada.Direccion.District <br />
        <b>Señas:</b> @FacturaGenerada.Direccion.OtherDetails
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Puesto</th>
                <th>Producto</th>
                <th>Cant.</th>
                <th>Precio</th>
                <th>Total línea</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in FacturaGenerada.Productos)
            {
                <tr>
                    <td>@p.Productor</td>
                    <td>@p.NombreProducto</td>
                    <td>@p.Cantidad</td>
                    <td>₡@p.Precio</td>
                    <td>₡@(p.Precio* p.Cantidad)</td>
                </tr>
            }
        </tbody>
    </table>

    <h5>
        Subtotal: ₡@FacturaGenerada.ObtenerSubtotalConDescuento() <br />
        Impuesto: ₡@FacturaGenerada.ObtenerImpuesto() <br />
        <b>Total:</b> ₡@FacturaGenerada.ObtenerTotal()
    </h5>
}

@code {
    private List<Producto> Productos = new();

    private decimal TotalCarrito => Productos.Sum(x => x.Precio * x.Cantidad);

    private string MensajeExito = string.Empty;
    private string MensajeError = string.Empty;

    private string Username = string.Empty;
    private string Nombre = string.Empty;
    private string Apellido = string.Empty;

    private string ProvinciaEntrega = string.Empty;
    private string DistritoEntrega = string.Empty;
    private string SenasEntrega = string.Empty;

    private MetodoPago MetodoPagoSeleccionado = MetodoPago.Efectivo;

    private Factura? FacturaGenerada;

    protected override void OnInitialized()
    {
        Productos = CarritoService.ObtenerProductos();
        FacturaGenerada = null;
    }

    private void Eliminar(string productor, string producto)
    {
        CarritoService.EliminarProducto(productor, producto);
        Productos = CarritoService.ObtenerProductos();
    }

    private void Vaciar()
    {
        CarritoService.VaciarCarrito();
        Productos = CarritoService.ObtenerProductos();
    }

    private void FinalizarCompra()
    {
        MensajeExito = string.Empty;
        MensajeError = string.Empty;
        FacturaGenerada = null;

        if (Productos.Count == 0)
        {
            MensajeError = "No se puede generar una factura porque el carrito está vacío.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Username))
        {
            MensajeError = "Se debe indicar el username del cliente para generar la factura.";
            return;
        }

        try
        {
            var cliente = new Usuario(
                name: string.IsNullOrWhiteSpace(Nombre) ? "Cliente" : Nombre,
                lastName: string.IsNullOrWhiteSpace(Apellido) ? "Web" : Apellido,
                username: Username,
                password: "N/A",
                directions: "[]",
                tipoUsuarioTexto: "Cliente"
            );

            var direccion = new Direccion
            {
                Province = ProvinciaEntrega ?? string.Empty,
                District = DistritoEntrega ?? string.Empty,
                OtherDetails = SenasEntrega ?? string.Empty,
                IsPrincipal = true
            };

            var factura = FacturaService.GenerarFactura(
                cliente: cliente,
                direccion: direccion,
                metodoPago: MetodoPagoSeleccionado,
                productos: CarritoService.ObtenerProductos()
            );

            FacturaService.GuardarFacturaEnCsv(factura);

            FacturaGenerada = factura;

            CarritoService.VaciarCarrito();
            Productos = CarritoService.ObtenerProductos();

            MensajeExito = "La factura fue generada, guardada y mostrada en pantalla.";
        }
        catch (Exception ex)
        {
            MensajeError = $"Ocurrió un error al generar la factura: {ex.Message}";
        }
    }
}
